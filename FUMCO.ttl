###  https://www.w3id.org/fumco/BatteryVoltage
<https://www.w3id.org/fumco/BatteryVoltage> rdf:type owl:Class ;
                                            rdfs:subClassOf <https://www.w3id.org/fumco/Capacity> ;
                                            rdfs:comment "This is just a domain specific class give for the sake of example, to showcase possible extensions of the ontology." ;
                                            rdfs:label "Battery Voltage" .


###  https://www.w3id.org/fumco/Behaviour
<https://www.w3id.org/fumco/Behaviour> rdf:type owl:Class ;
                                       rdfs:subClassOf <https://w3id.org/DOLCE/OWL/DOLCEbasic#Perdurant> ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty [ owl:inverseOf <https://www.w3id.org/fumco/participates-as-doer>
                                                                        ] ;
                                                         owl:someValuesFrom <https://www.w3id.org/fumco/TechnicalArtifact>
                                                       ] ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty [ owl:inverseOf <https://www.w3id.org/fumco/participates-as-flow>
                                                                        ] ;
                                                         owl:someValuesFrom owl:Thing
                                                       ] ;
                                       rdfs:comment """This class is partially characterized by the fact that one can identify two ‘processual’ roles in the sense of: an active one, called doer, and a passive one, called operand or flow. 
For instance, a cutting action entails that there is something that is the subject of the action, say a saw (or the system formed by a person or machine using the saw), and the object of the action, say a beam of wood.""" ;
                                       rdfs:label "Behaviour" ;
                                       iof-av:naturalLanguageDefinition "A subclass of DOLCE perdurants, representing perdurants from the point of view of a selected artifact, which is seen as the active agent (\"doer\") in the perdurant." .


###  https://www.w3id.org/fumco/Capability
<https://www.w3id.org/fumco/Capability> rdf:type owl:Class ;
                                        rdfs:subClassOf <https://www.w3id.org/fumco/RelationalQuality> ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty <https://w3id.org/DOLCE/OWL/DOLCEbasic#specificallyDependsOn> ;
                                                          owl:someValuesFrom <https://www.w3id.org/fumco/Capacity>
                                                        ] ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty <https://www.w3id.org/fumco/definition-founded-on> ;
                                                          owl:someValuesFrom <https://www.w3id.org/fumco/OntologicalFunction>
                                                        ] ;
                                        rdfs:label "Capability" ;
                                        skos:example "The capability of heating, the capability of generating electrical energy" ;
                                        iof-av:firstOrderLogicAxiom "Capability(x) → ∃y(Capacity(y)∧founded(x,y))" ;
                                        iof-av:firstOrderLogicDefinition "Capability(x) ↔ relationalQt(x)∧∃y(FunctionOnt(y)∧foundedDef(x,y))" ;
                                        iof-av:naturalLanguageDefinition "The ability of an entity of executing some ontological function" ;
                                        iof-av:semiFormalNaturalLanguageAxiom "A capability is founded on some capacity" ;
                                        iof-av:semiFormalNaturalLanguageDefinition "A relational quality is a capability if and only if is definition-founded on some ontological function" .


###  https://www.w3id.org/fumco/Capacity
<https://www.w3id.org/fumco/Capacity> rdf:type owl:Class ;
                                      rdfs:subClassOf <https://www.w3id.org/fumco/RelationalQuality> ,
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty <https://w3id.org/DOLCE/OWL/DOLCEbasic#specificallyDependsOn> ;
                                                        owl:someValuesFrom <https://www.w3id.org/fumco/IntrinsicQuality>
                                                      ] ,
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty [ owl:inverseOf <https://w3id.org/DOLCE/OWL/DOLCEbasic#specificallyDependsOn>
                                                                       ] ;
                                                        owl:someValuesFrom <https://www.w3id.org/fumco/Capability>
                                                      ] ;
                                      rdfs:comment "Capacity(x) → ∃y(Capability(y) ∧ specificallyDependentOn(y, x))" ;
                                      rdfs:label "Capacity" ;
                                      skos:example "Battery voltage, Flow rate, Resistance" ;
                                      iof-av:firstOrderLogicAxiom "Capacity(x) → relationalQt(x) ∧ ∃y(specificallyDependentOn(x, y) ∧ intrinsicQt(y) ∧ bearer(x) = bearer(y))" ;
                                      iof-av:naturalLanguageDefinition "Capacities are complex relational qualities which found capabilities, and are themselves founded on intrinsic qualities. We view them as \"parameters\" of capabilities." .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <https://www.w3id.org/fumco/Capacity> ;
   owl:annotatedProperty rdfs:comment ;
   owl:annotatedTarget "Capacity(x) → ∃y(Capability(y) ∧ specificallyDependentOn(y, x))" ;
   iof-av:semiFormalNaturalLanguageAxiom "“Each capacity has a capability which is dependent on that capacity”"
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <https://www.w3id.org/fumco/Capacity> ;
   owl:annotatedProperty iof-av:firstOrderLogicAxiom ;
   owl:annotatedTarget "Capacity(x) → relationalQt(x) ∧ ∃y(specificallyDependentOn(x, y) ∧ intrinsicQt(y) ∧ bearer(x) = bearer(y))" ;
   iof-av:semiFormalNaturalLanguageAxiom "“A capacity is a relational quality and is dependent on some intrinsic quality, which is carried by the same bearer.”"
 ] .


###  https://www.w3id.org/fumco/Concept
<https://www.w3id.org/fumco/Concept> rdf:type owl:Class ;
                                     rdfs:subClassOf <https://w3id.org/DOLCE/OWL/DOLCEbasic#NonAgentiveSocialObject> ;
                                     rdfs:comment """Concepts are introduced by Masolo (https://www.istc.cnr.it/en/content/social-roles-and-their-descriptions) as a sort of reified types or classificators. They are useful e.g. to describe the change in time of or the relations with other entities of types/classificators. 

In particular, this is the DOLCE-class that subsumes roles, see e.g. https://hal.science/hal-04383614/document""" ;
                                     rdfs:isDefinedBy "https://www.istc.cnr.it/en/content/social-roles-and-their-descriptions" ;
                                     rdfs:label "Concept" .


###  https://www.w3id.org/fumco/Connect
<https://www.w3id.org/fumco/Connect> rdf:type owl:Class ;
                                     rdfs:subClassOf :MereologicalJoinEvent ,
                                                     <https://www.w3id.org/fumco/PhysicalObjectOntologicalFunction> ;
                                     rdfs:label "Connect" ;
                                     skos:example "The function of a fastener" ;
                                     iof-av:firstOrderLogicDefinition """Connect(x) ↔ (CL(y, x) ↔ E(y) ∧ startState(y, si, ti) ∧ endState(y, s f , t f ) ∧ Goal(s f ) ∧
∃a, b, c(POB(a)∧POB(b)∧POB(c)∧PC(a, si, ti)∧PC(a, s f , t f )∧PC(b, si, ti)∧PC(b, s f , t f )∧PC(c, s f , t f )∧
P(a, c, t f ) ∧ P(b, c, t f )) ∧ ¬∃c′(POB(c′) ∧ PC(c′, si, ti) ∧ P(a, c′, ti) ∧ P(b, c′, ti)))""" ;
                                     iof-av:semiFormalNaturalLanguageDefinition "A concept is of connect type if and only if it classifies precisely those events that are transitions between a starting state (si, with time extension ti) and a final state (s f , with extension t f ) and, moreover, there are two physical objects (a and b) that participate in such states and, during the final state but not in the initial one, they are both part of a physical object (c)" .


###  https://www.w3id.org/fumco/Convert
<https://www.w3id.org/fumco/Convert> rdf:type owl:Class ;
                                     rdfs:subClassOf :Reclassification ;
                                     rdfs:comment "In OWL the class is left as a primitive due to the complexity of the definition. In the future, or when needed, it should be studied how to give partial or full definition within OWL." ;
                                     rdfs:label "Convert" ;
                                     skos:example "the function of a(ny) transducer, the function of  an electric motor of converting electrical energy into rotatory motion" ;
                                     iof-av:firstOrderLogicDefinition """Convert(x) ↔ (CL(y, x) ↔ E(y) ∧ startState(y, si, ti) ∧ endState(y, s f , t f ) ∧ Goal(s f ) ∧
∃Φ, Ψ, a(Φ ∈ N R ∧ Ψ ∈ N R ∧ Ψ ∩ Φ = ∅ ∧ PC(a, si, ti) ∧ PC(a, s f , t f ) ∧ Φ(a, ti) ∧ Ψ(a, t f )))""" ;
                                     iof-av:semiFormalNaturalLanguageDefinition """A concept is of convert type if and only if it classifies precisely those events that are transitions between a starting state (si, with time extension ti) and a desired final state (s f , with extension t f ) and, moreover, there is an entity (a) that at time ti is instance of a type (Φ), while at time t f is instance of a different, disjoint, type (Ψ). Necessarily, Φ and Ψ are types belonging to the set of all non-rigid types of the underlying ontology
(N R)""" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <https://www.w3id.org/fumco/Convert> ;
   owl:annotatedProperty iof-av:firstOrderLogicDefinition ;
   owl:annotatedTarget """Convert(x) ↔ (CL(y, x) ↔ E(y) ∧ startState(y, si, ti) ∧ endState(y, s f , t f ) ∧ Goal(s f ) ∧
∃Φ, Ψ, a(Φ ∈ N R ∧ Ψ ∈ N R ∧ Ψ ∩ Φ = ∅ ∧ PC(a, si, ti) ∧ PC(a, s f , t f ) ∧ Φ(a, ti) ∧ Ψ(a, t f )))""" ;
   rdfs:comment "The empry intersection between phi and psi is intended to mean that at any given time the concept extensions are disjointed"
 ] .


###  https://www.w3id.org/fumco/ConvertEnergy
<https://www.w3id.org/fumco/ConvertEnergy> rdf:type owl:Class ;
                                           rdfs:subClassOf <https://www.w3id.org/fumco/QualityValueOntologicalFunction> ;
                                           rdfs:comment "Note that putting energy conversion under \"Ontological Functions about Quality Values\" entails the conceptualization of energy as a quality of bodies." ;
                                           rdfs:label "Convert energy" ;
                                           skos:example "Converting electrical energy into rotatory motion" .


###  https://www.w3id.org/fumco/Decrease
<https://www.w3id.org/fumco/Decrease> rdf:type owl:Class ;
                                      rdfs:subClassOf <https://www.w3id.org/fumco/QualityValueOntologicalFunction> ;
                                      owl:disjointWith <https://www.w3id.org/fumco/Increase> ;
                                      rdfs:label "Decrease" ;
                                      skos:example "The function of the heat sink is to decrease the temperature of the processor" ;
                                      iof-av:naturalLanguageDefinition "An concept that classifies a perdurant if the value of some quality (that takes values in an ordered quality space) related to it decreases" .


###  https://www.w3id.org/fumco/EndurantOntologicalFunction
<https://www.w3id.org/fumco/EndurantOntologicalFunction> rdf:type owl:Class ;
                                                         rdfs:subClassOf :ParticularOntologicalFunction ;
                                                         rdfs:label "Ontological Function about Endurants" ;
                                                         iof-av:naturalLanguageDefinition "An concept that classifies a perdurant based on what happens to some endurant related to it" .


###  https://www.w3id.org/fumco/EngineeringMethod
<https://www.w3id.org/fumco/EngineeringMethod> rdf:type owl:Class ;
                                               rdfs:subClassOf <https://w3id.org/DOLCE/OWL/DOLCEbasic#NonAgentiveSocialObject> ;
                                               rdfs:comment "The first-order axiomatization is too complex to report it here." ;
                                               rdfs:label "Engineering Method" ;
                                               skos:example "welding, spot welding, joining by fasteners, cutting by asportation of material, cutting with a saw-blade, using a voltage divider" ;
                                               iof-av:naturalLanguageDefinition """Engineering methods represent the shared engineering knowledge about ways of implementing functions through functional decomposition, and are conceptualized as individual under DOLCE's non-agentive social objects. 
They are, essentially, plans, list of steps to be executed in order to execute the decomposed function.""" .


###  https://www.w3id.org/fumco/FeatureOntologicalFunction
<https://www.w3id.org/fumco/FeatureOntologicalFunction> rdf:type owl:Class ;
                                                        rdfs:subClassOf <https://www.w3id.org/fumco/EndurantOntologicalFunction> ;
                                                        rdfs:label "Ontological Function about Features" ;
                                                        iof-av:naturalLanguageDefinition "An concept that classifies a perdurant based on what happens to some feature related to it" .


###  https://www.w3id.org/fumco/FlowRate
<https://www.w3id.org/fumco/FlowRate> rdf:type owl:Class ;
                                      rdfs:subClassOf <https://www.w3id.org/fumco/Capacity> ;
                                      rdfs:comment "This is just a domain specific class give for the sake of example, to showcase possible extensions of the ontology." ;
                                      rdfs:label "Flow Rate" .


###  https://www.w3id.org/fumco/Goal
<https://www.w3id.org/fumco/Goal> rdf:type owl:Class ;
                                  rdfs:subClassOf <https://www.w3id.org/fumco/Concept> ;
                                  rdfs:label "Goal" ;
                                  skos:example "The furnace should be brought to the temperature of 800°C" ;
                                  iof-av:firstOrderLogicAxiom "Goal(x) → CN(x) ∧ ∀y, t(CL(y, x, t) → STV(y))" ;
                                  iof-av:isPrimitive "true"^^xsd:boolean ;
                                  iof-av:naturalLanguageDefinition "Goals are descriptions of states of technical artifacts selected by some user." ;
                                  iof-av:primitiveRationale """Goals are outside the scope of this ontology, which focuses on functions. 
Their proper definition is delegated to an external ontology. 
We proceed with a commonsense meaning of goals.""" ;
                                  iof-av:semiFormalNaturalLanguageAxiom "goals are concepts that classifies stative perdurants only." .


###  https://www.w3id.org/fumco/Increase
<https://www.w3id.org/fumco/Increase> rdf:type owl:Class ;
                                      rdfs:subClassOf <https://www.w3id.org/fumco/QualityValueOntologicalFunction> ;
                                      rdfs:label "Increase" ;
                                      iof-av:naturalLanguageDefinition "An concept that classifies a perdurant if the value of some quality (that takes values in an ordered quality space) related to it decreases" .


###  https://www.w3id.org/fumco/IntrinsicQuality
<https://www.w3id.org/fumco/IntrinsicQuality> rdf:type owl:Class ;
                                              rdfs:subClassOf <https://w3id.org/DOLCE/OWL/DOLCEbasic#Quality> ;
                                              owl:disjointWith <https://www.w3id.org/fumco/RelationalQuality> ;
                                              rdfs:label "Intrinsic Quality" ;
                                              skos:example "Length, Mass, Shape" ;
                                              iof-av:firstOrderLogicDefinition "intrinsicQt(x) ↔ (Q(x) ∧¬relationalQt(x))" ;
                                              iof-av:semiFormalNaturalLanguageDefinition "We define relational qualities as the class complementary to Relational qualities" .


###  https://www.w3id.org/fumco/OntologicalFunction
<https://www.w3id.org/fumco/OntologicalFunction> rdf:type owl:Class ;
                                                 rdfs:subClassOf <https://www.w3id.org/fumco/Concept> ,
                                                                 [ rdf:type owl:Restriction ;
                                                                   owl:onProperty <https://www.w3id.org/fumco/super-concept-of> ;
                                                                   owl:someValuesFrom <https://www.w3id.org/fumco/SystemicFunction>
                                                                 ] ,
                                                                 [ rdf:type owl:Restriction ;
                                                                   owl:onProperty <https://www.w3id.org/fumco/super-concept-of> ;
                                                                   owl:allValuesFrom [ rdf:type owl:Class ;
                                                                                       owl:unionOf ( <https://www.w3id.org/fumco/OntologicalFunction>
                                                                                                     <https://www.w3id.org/fumco/SystemicFunction>
                                                                                                   )
                                                                                     ]
                                                                 ] ;
                                                 rdfs:comment """Note that the taxonomy of ontological functions uses two facets: a logic-based division of events (Stasis, Destruction, Division, Reclassification, etc.) and an ontology-based clasification of events (Ontological Function about Features, Ontological Function about Physical Objects, etc.). 

The facets are (partially) independent so they can intersect (e.g. Convert is a subclass of both Reclassification and Ontological Function about Physical Objects). 

Note also that the ontology-based factes depend on an ontology other than FUMCO. In our case it is DOLCE, but this is not a necessity.""" ;
                                                 rdfs:label "Ontological Function" ;
                                                 iof-av:firstOrderLogicAxiom "FunctionOnt(x) → (∃y(SP(y,x) ∧ FunctionSys(y)) ∧ ∀y(SP(y,x) ∧ ¬FunctionOnt(y) → FunctionSys(y)))" ;
                                                 iof-av:isPrimitive "true"^^xsd:boolean ;
                                                 iof-av:naturalLanguageDefinition "Ontological functions are functions that do not depend on either a method nor a system, and are generalisations of systemic functions" ;
                                                 iof-av:primitiveRationale """We don't make a committment regarding the definition of this class.

A possibility is to define ontological functions by comprehension of a list of specific types of ontological functions, provided that such a list is actually exhaustive. For example:

OntologicalFunction(x) ⇐⇒ (Connect(x) ∨ Divide(x) ∨ Convert(x) ∨ . . . )

On the other hand, one could supply an intrinsic definition, along the lines of, say:

“A concept is an ontological function if and only if it classifies exactly those events
consisting in a transition such that the changes (or the absence thereof) between
the initial and final states is characterized in terms of a formula expressed in the
language of an upper ontology.”

However, a formalization of this latter definition would require higher-order logic. Since
we don’t want to wander that far with the theory, we refrain from giving an intrinsic
definition of ontological functions. 

Instead, an extensional definition, as the former one above, can only be done while another ontology is chone to supply the vocabulary with which to formulate the definitions of the various subclasses. Since there are more way to do this, we do not proceed on in such a way here.""" ;
                                                 iof-av:semiFormalNaturalLanguageAxiom "any ontological function x is specialized by some systemic function y and, beyond ontological functions, it classifies systemic functions only" .


###  https://www.w3id.org/fumco/PerdurantOntologicalFunction
<https://www.w3id.org/fumco/PerdurantOntologicalFunction> rdf:type owl:Class ;
                                                          rdfs:subClassOf :ParticularOntologicalFunction ;
                                                          rdfs:label "Ontological Function about Perdurants" ;
                                                          iof-av:naturalLanguageDefinition "An concept that classifies a perdurant based on what happens to some other perdurant related to it" .


###  https://www.w3id.org/fumco/PhysicalObjectOntologicalFunction
<https://www.w3id.org/fumco/PhysicalObjectOntologicalFunction> rdf:type owl:Class ;
                                                               rdfs:subClassOf <https://www.w3id.org/fumco/EndurantOntologicalFunction> ;
                                                               rdfs:label "Ontological Function about Physical Objects" ;
                                                               iof-av:naturalLanguageDefinition "An concept that classifies a perdurant based on what happens to some physical object related to it" .


###  https://www.w3id.org/fumco/ProcessOntologicalFunction
<https://www.w3id.org/fumco/ProcessOntologicalFunction> rdf:type owl:Class ;
                                                        rdfs:subClassOf <https://www.w3id.org/fumco/PerdurantOntologicalFunction> ;
                                                        rdfs:label "Ontological Function about Processes" ;
                                                        iof-av:naturalLanguageDefinition "An concept that classifies a perdurant based on what happens to some (other) process related to it" .


###  https://www.w3id.org/fumco/QualityOntologicalFunction
<https://www.w3id.org/fumco/QualityOntologicalFunction> rdf:type owl:Class ;
                                                        rdfs:subClassOf :ParticularOntologicalFunction ;
                                                        rdfs:label "Ontological Function about Qualities" ;
                                                        iof-av:naturalLanguageDefinition "An concept that classifies a perdurant based on what happens to some quality related to it" .


###  https://www.w3id.org/fumco/QualityValueOntologicalFunction
<https://www.w3id.org/fumco/QualityValueOntologicalFunction> rdf:type owl:Class ;
                                                             rdfs:subClassOf :ParticularOntologicalFunction ;
                                                             rdfs:label "Ontological Function about Quality Values" ;
                                                             iof-av:firstOrderLogicDefinition """ChangeQualityValue(x) ↔ (CL(y, x) ↔ E(y) ∧ ∃si, sf, ti, tf, a, q, vi, vf
(sState(y, si, ti)∧Goal(sf)∧eState(y, sf, tf)∧qt(q, a)∧PC(a, si, ti)∧PC(a, sf, tf)∧
ql(q, vi, ti) ∧ ql(q, vf, tf) ∧ ¬(vi = vf)))""" ;
                                                             iof-av:naturalLanguageDefinition "An concept that classifies a perdurant based on what happens to some qualit-value (DOLCE-region) related to it" ;
                                                             iof-av:semiFormalNaturalLanguageDefinition "A ‘change of quality-value’ function is a classifier of events that are transitions between a starting state (si, with time extension ti) and a desired final state (sf, with extension tf) with a participating entity (a) which has a quality (q) with different values, vi and vf, at times ti and tf, respectively." .


###  https://www.w3id.org/fumco/RelationalQuality
<https://www.w3id.org/fumco/RelationalQuality> rdf:type owl:Class ;
                                               rdfs:subClassOf <https://w3id.org/DOLCE/OWL/DOLCEbasic#Quality> ;
                                               rdfs:label "Relational Quality" ;
                                               iof-av:naturalLanguageDefinition "Heuristically, any quality that \"depends on\" some external entity, in some sense." .


###  https://www.w3id.org/fumco/Resistance
<https://www.w3id.org/fumco/Resistance> rdf:type owl:Class ;
                                        rdfs:subClassOf <https://www.w3id.org/fumco/Capacity> ;
                                        rdfs:comment "This is just a domain specific class give for the sake of example, to showcase possible extensions of the ontology." ;
                                        rdfs:label "Resistance" .


###  https://www.w3id.org/fumco/Role
<https://www.w3id.org/fumco/Role> rdf:type owl:Class ;
                                  rdfs:subClassOf <https://www.w3id.org/fumco/Concept> ,
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty <https://www.w3id.org/fumco/definition-founded-on> ;
                                                    owl:someValuesFrom <https://www.w3id.org/fumco/Concept>
                                                  ] ;
                                  rdfs:isDefinedBy "https://www.istc.cnr.it/en/content/social-roles-and-their-descriptions" ;
                                  rdfs:label "Role" ;
                                  iof-av:firstOrderLogicAxiom "RL(x) → ∃yfoundedInst(x,y)" ;
                                  iof-av:isPrimitive "true"^^xsd:boolean ;
                                  iof-av:primitiveRationale "A full definition is delegated to the alignment with an upper ontology" ;
                                  iof-av:semiFormalNaturalLanguageAxiom "if x is a role, then there is a y on which it is instantiation-founded" .


###  https://www.w3id.org/fumco/SelectedFunction
<https://www.w3id.org/fumco/SelectedFunction> rdf:type owl:Class ;
                                              owl:equivalentClass [ rdf:type owl:Restriction ;
                                                                    owl:onProperty <https://www.w3id.org/fumco/function-of> ;
                                                                    owl:someValuesFrom <https://www.w3id.org/fumco/TechnicalArtifact>
                                                                  ] ;
                                              rdfs:subClassOf <https://www.w3id.org/fumco/Concept> ;
                                              rdfs:label "Selected Function" ;
                                              iof-av:firstOrderLogicDefinition "SelectedFunction(f) ↔ ∃x(hasFunction(x, f))" ;
                                              iof-av:naturalLanguageDefinition "The function of an object, as intended by some agent" ;
                                              iof-av:semiFormalNaturalLanguageDefinition "Selected functions are, by definition, exactly those attributed to an entity by an agent." .


###  https://www.w3id.org/fumco/SolvedFunction
<https://www.w3id.org/fumco/SolvedFunction> rdf:type owl:Class ;
                                            owl:equivalentClass [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <https://www.w3id.org/fumco/main-function-of> ;
                                                                  owl:someValuesFrom <https://www.w3id.org/fumco/EngineeringMethod>
                                                                ] ;
                                            rdfs:subClassOf <https://www.w3id.org/fumco/Role> ;
                                            rdfs:comment "The first order logic definition is changed in OWL: we give an approximation, which exploits the relation \"main-function-of\", which replaces the main-function class. The main function class itself is not present in this OWL ontology." ;
                                            rdfs:label "Solved Function" ;
                                            iof-av:firstOrderLogicDefinition "solvedFunction(x) ↔ mainFunction(x)" ;
                                            iof-av:naturalLanguageDefinition "Solved functions are functions for which a plan of how to carry them out exist." ;
                                            iof-av:semiFormalNaturalLanguageDefinition "engineering functions and main-functions coincide" .


###  https://www.w3id.org/fumco/System
<https://www.w3id.org/fumco/System> rdf:type owl:Class ;
                                    rdfs:comment """A system, especially in the engineering context, is often thought as a whole made by parts, called components, whose bahavior contributes in a particular way to the functioning of the whole system. 

In this sense a system can be anything that is subject to such an analysis: even the smallest screw, say, is made by different parts that play different roles in the realization of the function of the screw, and they are important for the screw designer or manufacturer.""" ;
                                    rdfs:label "System" ;
                                    iof-av:isPrimitive "true"^^xsd:boolean ;
                                    iof-av:primitiveRationale "The definition of \"system\" is outside the scope of this ontology, where it is used as a primitive, and with a (engineering-)commonsense meaning" .


###  https://www.w3id.org/fumco/SystemicFunction
<https://www.w3id.org/fumco/SystemicFunction> rdf:type owl:Class ;
                                              rdfs:subClassOf <https://www.w3id.org/fumco/Role> ,
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty <https://www.w3id.org/fumco/classifies> ;
                                                                owl:allValuesFrom [ owl:intersectionOf ( [ owl:intersectionOf ( <https://www.w3id.org/fumco/Behaviour>
                                                                                                                                [ rdf:type owl:Restriction ;
                                                                                                                                  owl:onProperty <https://www.w3id.org/fumco/causally-contributes-to> ;
                                                                                                                                  owl:someValuesFrom <https://www.w3id.org/fumco/Goal>
                                                                                                                                ]
                                                                                                                              ) ;
                                                                                                           rdf:type owl:Class
                                                                                                         ]
                                                                                                         [ rdf:type owl:Restriction ;
                                                                                                           owl:onProperty <https://w3id.org/DOLCE/OWL/DOLCEbasic#specificallyDependsOn> ;
                                                                                                           owl:someValuesFrom <https://www.w3id.org/fumco/System>
                                                                                                         ]
                                                                                                       ) ;
                                                                                    rdf:type owl:Class
                                                                                  ]
                                                              ] ;
                                              rdfs:comment """Systemic functions are understood as role concepts that
– classify only behaviors, relative to some behaving artifact,
– are contextualized by a system that contains the behaving artifact and for whom a goal state has been
selected,
– the classified behaviors contribute to the goal of the system.""" ;
                                              rdfs:label "Systemic Function" ;
                                              skos:example "The electrovalve controls the cylinder" ;
                                              iof-av:firstOrderLogicAxiom "FunctionSys(x) ↔ ∃yFunctionOfSys(x,y)" ;
                                              iof-av:firstOrderLogicDefinition """FunctionOfSys(x,y) ↔ (RL(x) ∧∃z,g(System(z) ∧goalOf(g,z) ∧∃b,t(CL(b,x,t)  ∧P(y,z,t))
    ∀b,t((CL(b,x,t) ∧P(y,z,t)) → (Behaviour(b) ∧participatesAsDoer(y,b,t)
    ∧causalContr(b,g)))))""" ;
                                              iof-av:naturalLanguageDefinition "The role of a component of a system in determining the behavior of the whole system" ;
                                              iof-av:semiFormalNaturalLanguageAxiom "“x is a systemic function if and only if it is the systemic function of some object y”" ;
                                              iof-av:semiFormalNaturalLanguageDefinition "“x is a systemic function of y if and only if x is a role and there exist a system z and a goal g for z such that x is satisfied only by behaviors which have y as doer and causally contribute to achieve g, whenever y is part of z”" .


###  https://www.w3id.org/fumco/TechnicalArtifact
<https://www.w3id.org/fumco/TechnicalArtifact> rdf:type owl:Class ;
                                               rdfs:subClassOf <https://w3id.org/DOLCE/OWL/DOLCEbasic#NonAgentivePhysicalObject> ;
                                               rdfs:comment "For the sake of simplicity, we focus on technical artifacts that are physical objects. In the future, or if the need arises, it should be considered the case of artifacts that are not physical objects also." ;
                                               rdfs:label "(Physical) Technical Artifact" ;
                                               skos:example "a pipe, a motor, a battery" ;
                                               iof-av:naturalLanguageDefinition "A technical artifact is any physical object that came into being through some intentional technical process, such as, e.g., any car, plane, tooling machine, or mechanical device." .


###  https://www.w3id.org/fumco/ToGroove
<https://www.w3id.org/fumco/ToGroove> rdf:type owl:Class ;
                                      rdfs:subClassOf <https://www.w3id.org/fumco/FeatureOntologicalFunction> ;
                                      rdfs:comment "This is just a domain-level specific class given as an example" ;
                                      rdfs:label "To Groove" ;
                                      skos:example "A groove feature is added in some workpiece" ;
                                      iof-av:firstOrderLogicDefinition """ToGroove(x) ↔ (CL(y, x) ↔ E(y) ∧ ∃si, sf, ti, tf, a, f
(sState(y, si, ti)∧Goal(sf)∧eState(y, sf, tf)∧Groove(f)∧SD(f, a)∧PC(a, si, ti)∧
PC(a, sf, tf) ∧ ¬PRE(f, ti) ∧ PRE(f, tf)))""" ;
                                      iof-av:semiFormalNaturalLanguageDefinition """A ‘change to groove’ function is a classifier of events that are transitions between
a starting state (si, with time extension ti) and a desired final state (sf, with
extension tf) with a participating entity (a) that has a feature (f) of ‘Groove’
type at time tf but not at time ti.""" .


