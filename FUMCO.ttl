#################################################################

[ rdf:type owl:AllDisjointClasses ;
  owl:members ( <https://www.w3id.org/fumco/BatteryVoltage>
                <https://www.w3id.org/fumco/FlowRate>
                <https://www.w3id.org/fumco/Resistance>
              )
] .


